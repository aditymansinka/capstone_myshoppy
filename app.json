{
  "expo": {
    "name": "myShoppy",
    "slug": "myshoppy",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "newArchEnabled": true
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
